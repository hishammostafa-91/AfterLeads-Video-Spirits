{
  "$schema": "https://opencode.ai/config.json",

  // OpenCode 2 project configuration for AfterLeads-Video-Spirits.
  // Canonical description: docs/06-ai-automation.md §6.8. Changes need owner approval (G-18).
  // No model or provider is set here on purpose: each workstation chooses its own in the
  // user configuration (~/.config/opencode/opencode.jsonc).

  "shell": "pwsh",
  "default_agent": "build",
  "formatter": true,
  "snapshots": true,

  "watcher": {
    "ignore": [
      "target/**",
      "**/node_modules/**",
      "app/dist/**",
      "vcpkg_installed/**",
      "test-results/**",
      "playwright-report/**"
    ]
  },

  // Parallel work packages live in sibling worktrees (docs/06 §6.15, docs/10 §10.4.10).
  "worktree": {
    "directory": "../AfterLeads-Video-Spirits.worktrees"
  },

  // Ordered rules: the last matching rule wins (OpenCode 2 permissions model).
  "permissions": [
    // ---- Reading and searching -------------------------------------------------------
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },

    // ---- Paths outside the repository ------------------------------------------------
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*/AfterLeads-Video-Spirits.worktrees/*", "effect": "allow" },

    // ---- Editing ---------------------------------------------------------------------
    { "action": "edit", "resource": "*", "effect": "allow" },
    // Canonical documentation and governance: owner sees every change (G-18, G-19).
    { "action": "edit", "resource": "docs/*", "effect": "ask" },
    { "action": "edit", "resource": "LICENSE", "effect": "ask" },
    { "action": "edit", "resource": "TRADEMARKS.md", "effect": "ask" },
    { "action": "edit", "resource": "SECURITY.md", "effect": "ask" },
    { "action": "edit", "resource": "CODE_OF_CONDUCT.md", "effect": "ask" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "ask" },
    { "action": "edit", "resource": "opencode.jsonc", "effect": "ask" },
    { "action": "edit", "resource": ".opencode/*", "effect": "ask" },
    { "action": "edit", "resource": ".specify/memory/*", "effect": "ask" },
    { "action": "edit", "resource": ".githooks/*", "effect": "ask" },
    { "action": "edit", "resource": ".github/workflows/*", "effect": "ask" },
    { "action": "edit", "resource": "tools/docs/denylist.sha256", "effect": "ask" },

    // ---- Agents, skills, web ---------------------------------------------------------
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "ask" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "webfetch", "resource": "https://docs.rs/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://crates.io/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://v2.tauri.app/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://learn.microsoft.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://developer.mozilla.org/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://react-spectrum.adobe.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://dockview.dev/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://ffmpeg.org/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://www.w3.org/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://www.npmjs.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://github.github.io/spec-kit/*", "effect": "allow" },

    // ---- Shell: ask by default ---------------------------------------------------------
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Read-only inspection (PowerShell)
    { "action": "shell", "resource": "Get-ChildItem *", "effect": "allow" },
    { "action": "shell", "resource": "Get-Content *", "effect": "allow" },
    { "action": "shell", "resource": "Get-Item *", "effect": "allow" },
    { "action": "shell", "resource": "Get-Location *", "effect": "allow" },
    { "action": "shell", "resource": "Get-Command *", "effect": "allow" },
    { "action": "shell", "resource": "Get-FileHash *", "effect": "allow" },
    { "action": "shell", "resource": "Test-Path *", "effect": "allow" },
    { "action": "shell", "resource": "Resolve-Path *", "effect": "allow" },
    { "action": "shell", "resource": "Select-String *", "effect": "allow" },
    { "action": "shell", "resource": "Measure-Object *", "effect": "allow" },
    { "action": "shell", "resource": "Write-Output *", "effect": "allow" },
    { "action": "shell", "resource": "Write-Host *", "effect": "allow" },
    { "action": "shell", "resource": "Set-Location *", "effect": "allow" },

    // Git (routine, non-destructive)
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git switch *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git pull --ff-only *", "effect": "allow" },
    { "action": "shell", "resource": "git merge --no-ff *", "effect": "allow" },
    { "action": "shell", "resource": "git merge --abort", "effect": "allow" },
    { "action": "shell", "resource": "git push -u origin *", "effect": "allow" },
    { "action": "shell", "resource": "git push origin *", "effect": "allow" },
    { "action": "shell", "resource": "git worktree *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    { "action": "shell", "resource": "git config --get *", "effect": "allow" },
    { "action": "shell", "resource": "git tag -l *", "effect": "allow" },
    { "action": "shell", "resource": "git tag --list *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git grep *", "effect": "allow" },

    // GitHub CLI (read, and open pull requests)
    { "action": "shell", "resource": "gh auth status *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr create *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
    { "action": "shell", "resource": "gh run list *", "effect": "allow" },
    { "action": "shell", "resource": "gh run view *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view *", "effect": "allow" },

    // Rust
    { "action": "shell", "resource": "cargo build *", "effect": "allow" },
    { "action": "shell", "resource": "cargo check *", "effect": "allow" },
    { "action": "shell", "resource": "cargo test *", "effect": "allow" },
    { "action": "shell", "resource": "cargo nextest *", "effect": "allow" },
    { "action": "shell", "resource": "cargo clippy *", "effect": "allow" },
    { "action": "shell", "resource": "cargo fmt *", "effect": "allow" },
    { "action": "shell", "resource": "cargo doc *", "effect": "allow" },
    { "action": "shell", "resource": "cargo run *", "effect": "allow" },
    { "action": "shell", "resource": "cargo tree *", "effect": "allow" },
    { "action": "shell", "resource": "cargo metadata *", "effect": "allow" },
    { "action": "shell", "resource": "cargo deny *", "effect": "allow" },
    { "action": "shell", "resource": "cargo llvm-cov *", "effect": "allow" },
    { "action": "shell", "resource": "cargo bench *", "effect": "allow" },
    { "action": "shell", "resource": "rustup show *", "effect": "allow" },

    // Node / UI (installs only from the lockfile)
    { "action": "shell", "resource": "pnpm install --frozen-lockfile *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm -C app *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm tauri *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm exec *", "effect": "allow" },

    // Repository scripts
    { "action": "shell", "resource": "pwsh -File tools/*", "effect": "allow" },
    { "action": "shell", "resource": "pwsh -NoProfile -File tools/*", "effect": "allow" },
    { "action": "shell", "resource": "python tools/*", "effect": "allow" },
    { "action": "shell", "resource": "py tools/*", "effect": "allow" },
    { "action": "shell", "resource": "specify version *", "effect": "allow" },
    { "action": "shell", "resource": "specify check *", "effect": "allow" },
    { "action": "shell", "resource": "ffprobe *", "effect": "allow" },

    // ---- Shell: always ask (overrides the allows above) ------------------------------
    { "action": "shell", "resource": "cargo add *", "effect": "ask" },
    { "action": "shell", "resource": "cargo remove *", "effect": "ask" },
    { "action": "shell", "resource": "cargo update *", "effect": "ask" },
    { "action": "shell", "resource": "cargo install *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm -C app add *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm -C app remove *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm -C app update *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm add *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm remove *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm update *", "effect": "ask" },
    { "action": "shell", "resource": "npx *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git branch --delete --force *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git cherry-pick *", "effect": "ask" },
    { "action": "shell", "resource": "git stash *", "effect": "ask" },
    { "action": "shell", "resource": "git tag *", "effect": "ask" },
    { "action": "shell", "resource": "git tag -l *", "effect": "allow" },
    { "action": "shell", "resource": "git tag --list *", "effect": "allow" },
    { "action": "shell", "resource": "git config *", "effect": "ask" },
    { "action": "shell", "resource": "git config --get *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "ask" },
    { "action": "shell", "resource": "Remove-Item *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "del *", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "Invoke-WebRequest *", "effect": "ask" },
    { "action": "shell", "resource": "Invoke-RestMethod *", "effect": "ask" },
    { "action": "shell", "resource": "curl *", "effect": "ask" },
    { "action": "shell", "resource": "winget *", "effect": "ask" },
    { "action": "shell", "resource": "Set-ExecutionPolicy *", "effect": "ask" },

    // ---- Shell: never (also enforced as hard policies below) --------------------------
    { "action": "shell", "resource": "git push * main", "effect": "deny" },
    { "action": "shell", "resource": "git push * main *", "effect": "deny" },
    { "action": "shell", "resource": "git push * HEAD:main*", "effect": "deny" },
    { "action": "shell", "resource": "git push * *:main*", "effect": "deny" },
    { "action": "shell", "resource": "git push * refs/heads/main*", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push * -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push * +*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --tags*", "effect": "deny" },
    { "action": "shell", "resource": "git push * v*", "effect": "deny" },
    { "action": "shell", "resource": "git push * refs/tags/*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --mirror*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --delete*", "effect": "deny" },
    { "action": "shell", "resource": "git commit --no-verify*", "effect": "deny" },
    { "action": "shell", "resource": "git commit * --no-verify*", "effect": "deny" },
    { "action": "shell", "resource": "git commit -n*", "effect": "deny" },
    { "action": "shell", "resource": "git config core.hooksPath*", "effect": "deny" },
    { "action": "shell", "resource": "git config --local core.hooksPath*", "effect": "deny" },
    { "action": "shell", "resource": "git config --global core.hooksPath*", "effect": "deny" },
    { "action": "shell", "resource": "git -c core.hooksPath*", "effect": "deny" },
    { "action": "shell", "resource": "Invoke-Expression *", "effect": "deny" },
    { "action": "shell", "resource": "iex *", "effect": "deny" },
    { "action": "shell", "resource": "cargo publish*", "effect": "deny" },
    { "action": "shell", "resource": "npm publish*", "effect": "deny" },
    { "action": "shell", "resource": "pnpm publish*", "effect": "deny" },
    { "action": "shell", "resource": "gh release *", "effect": "deny" },
    { "action": "shell", "resource": "gh secret *", "effect": "deny" },
    { "action": "shell", "resource": "gh repo delete*", "effect": "deny" },
    { "action": "shell", "resource": "gh repo edit*", "effect": "deny" }
  ],

  // Hard denies that no approval can override (OpenCode 2 policies).
  "policies": [
    { "action": "tool.use", "resource": "shell:git push * main", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * main *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * HEAD:main*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * *:main*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * refs/heads/main*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push --force*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push -f*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * --force*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * -f*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * +*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * --tags*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * v*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * refs/tags/*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git commit --no-verify*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git commit * --no-verify*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git commit -n*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git config core.hooksPath*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git config --local core.hooksPath*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git config --global core.hooksPath*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git -c core.hooksPath*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:Invoke-Expression *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:iex *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:cargo publish*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:npm publish*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:pnpm publish*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh release *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh secret *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh repo delete*", "effect": "deny" }
  ]
}
