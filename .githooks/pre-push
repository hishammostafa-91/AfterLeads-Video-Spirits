# Push protection (docs/10-execution.md §10.4.13): never main, tags only for the owner, valid branch names.
set -u
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: pushing to '$remote_ref' is not allowed; open a pull request instead (G-03, G-05)." >&2
      status=1
      ;;
    refs/tags/*)
      if [ "${ALVS_OWNER_RELEASE:-0}" != "1" ]; then
        echo "pre-push: tags are created and pushed only by the owner (docs/08 OPS-08)." >&2
        status=1
      fi
      ;;
    refs/heads/*)
      name="${remote_ref#refs/heads/}"
      if ! printf '%s' "$name" | grep -Eq '^(feat|fix|docs|chore|ci|refactor|test|perf|i18n|build)/[0-9]{3,6}-[a-z0-9]+(-[a-z0-9]+)*$'; then
        echo "pre-push: branch name '$name' does not match <type>/<NNN>-<slug> (docs/10 §10.4.2)." >&2
        status=1
      fi
      ;;
  esac
done
exit $status
